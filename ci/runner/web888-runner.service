[Unit]
Description=web888-ng-os ephemeral GitHub Actions runner (one job per container)
After=network-online.target
Wants=network-online.target

[Service]
User=runner
ExecStart=/usr/local/bin/web888-runner.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
