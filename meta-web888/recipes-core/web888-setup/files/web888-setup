#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# web888-setup: the owner's settings from web888.txt on the SD card's FAT
# partition (/boot), applied at every boot before the network, SSH and
# web888d start: the network, the hostname, the admin password and an
# SSH key; a stable MAC address when the EEPROM has none. What it did
# goes to web888-setup.log next to web888.txt. Also the bitstream web888d
# loads (standard or channelizer), as its command line in /run, and the
# tunnels to the Internet (frp, cloudflared, rathole, chisel: each
# client's configuration in /run, its secret kept on the configuration
# partition).
#
# The FAT is written only when something changes: the password line
# replaced by "admin_password = (set)" once the password is taken (the
# same for the tunnels' secrets), a made-up password in
# web888-password.txt, the log when its text changes. Each write is a
# copy then a rename.
#
# The paths can be moved for tests (WEB888_BOOT, WEB888_CONFIG,
# WEB888_RUN, WEB888_SYS, WEB888D).
set -u

BOOT=${WEB888_BOOT:-/boot}
CONFIG=${WEB888_CONFIG:-/config}
RUN=${WEB888_RUN:-/run}
SYS=${WEB888_SYS:-/sys}
WEB888D=${WEB888D:-web888d}

TXT=$BOOT/web888.txt
LOG=$BOOT/web888-setup.log
PWTXT=$BOOT/web888-password.txt
TOML=$CONFIG/web888d.toml
BITDIR=${WEB888_BITDIR:-/usr/share/web888}
WEB888D_ENV=$RUN/web888/web888d.env
STATE=$CONFIG/web888-setup
NETDIR=$RUN/systemd/network
SSHDIR=$RUN/web888/ssh
NETIF=eth0

CR=$(printf '\r')
BOM=$(printf '\357\273\277')

report=""
problems=0
say() {
	report="$report$*
"
	echo "web888-setup: $*"
}
problem() {
	problems=$((problems + 1))
	say "PROBLEM: $*"
}

# --------------------------------------------------------------- the FAT

# (put_file often ends a pipeline, a subshell: what is mounted how is
# read from /proc/mounts, not kept in a variable)
boot_is_rw() {
	grep -q "^[^ ]* $BOOT vfat rw[, ]" /proc/mounts
}
boot_writable() {
	[ -n "${WEB888_BOOT:-}" ] && return 0
	boot_is_rw || mount -o remount,rw "$BOOT"
}
boot_done() {
	sync
	[ -n "${WEB888_BOOT:-}" ] && return 0
	boot_is_rw && mount -o remount,ro "$BOOT"
	return 0
}
# put_file NAME: stdin to NAME on the FAT (a copy, then a rename)
put_file() {
	boot_writable || { problem "can't write $(basename "$1") (the card is read-only?)"; return 1; }
	cat > "$1.new" && mv -f "$1.new" "$1"
}

# ------------------------------------------------------------ the file

trim() {
	printf '%s' "$1" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
}
# a value in matching quotes loses them
unquote() {
	case $1 in
	\"*\") v=${1#\"}; printf '%s' "${v%\"}" ;;
	\'*\') v=${1#\'}; printf '%s' "${v%\'}" ;;
	*) printf '%s' "$1" ;;
	esac
}

admin_password="" have_password=0
network="" address="" gateway="" dns="" hostname="" ssh_key="" bitstream=""
frp_server="" frp_token="" frp_name="" frp_remote_port="" cloudflared_token=""
rathole_server="" rathole_token="" rathole_name="" rathole_server_key=""
chisel_server="" chisel_auth="" chisel_fingerprint="" chisel_remote_port=""

read_settings() {
	n=0
	while IFS= read -r line || [ -n "$line" ]; do
		n=$((n + 1))
		line=${line%"$CR"}
		[ $n = 1 ] && line=${line#"$BOM"}
		line=$(trim "$line")
		case $line in
		'' | '#'*) continue ;;
		*=*) ;;
		*)
			problem "web888.txt line $n: not \"name = value\""
			continue
			;;
		esac
		key=$(trim "${line%%=*}" | tr 'A-Z' 'a-z')
		val=$(unquote "$(trim "${line#*=}")")
		case $key in
		admin_password) admin_password=$val have_password=1 ;;
		network) network=$(printf '%s' "$val" | tr 'A-Z' 'a-z') ;;
		address) address=$val ;;
		gateway) gateway=$val ;;
		dns) dns=$val ;;
		hostname) hostname=$val ;;
		ssh_key) ssh_key=$val ;;
		bitstream) bitstream=$(printf '%s' "$val" | tr 'A-Z' 'a-z') ;;
		frp_server) frp_server=$val ;;
		frp_token) frp_token=$val ;;
		frp_name) frp_name=$val ;;
		frp_remote_port) frp_remote_port=$val ;;
		cloudflared_token) cloudflared_token=$val ;;
		rathole_server) rathole_server=$val ;;
		rathole_token) rathole_token=$val ;;
		rathole_name) rathole_name=$val ;;
		rathole_server_key) rathole_server_key=$val ;;
		chisel_server) chisel_server=$val ;;
		chisel_auth) chisel_auth=$val ;;
		chisel_fingerprint) chisel_fingerprint=$val ;;
		chisel_remote_port) chisel_remote_port=$val ;;
		*) problem "web888.txt line $n: unknown setting \"$key\"" ;;
		esac
	done < "$TXT"
}

# ------------------------------------------------------------- checks

ipv4() {
	case $1 in
	*[!0-9.]* | .* | *. | *..*) return 1 ;;
	esac
	old_ifs=$IFS
	IFS=.
	set -- $1
	IFS=$old_ifs
	[ $# = 4 ] || return 1
	for o; do
		[ ${#o} -le 3 ] && [ "$o" -le 255 ] || return 1
	done
}
ipv4_prefix() {
	case $1 in
	*/*) ;;
	*) return 1 ;;
	esac
	p=${1#*/}
	case $p in
	'' | *[!0-9]*) return 1 ;;
	esac
	[ "$p" -ge 1 ] && [ "$p" -le 32 ] && ipv4 "${1%/*}"
}
valid_hostname() {
	case $1 in
	'' | -* | *- | *[!a-z0-9-]*) return 1 ;;
	esac
	[ ${#1} -le 63 ]
}

# ------------------------------------------------------------ the MAC

# The EEPROM's address (0x10, the device tree's nvmem cell) is kept as it
# is. Without a valid one the kernel makes a random address at every
# boot, and every boot would get another DHCP lease: then the unit keeps
# one random address, made once and saved in /config.
mac=""
mac_setting() {
	i=0
	while [ ! -e "$SYS/class/net/$NETIF" ] && [ $i -lt 10 ]; do
		sleep 1
		i=$((i + 1))
	done
	if [ ! -e "$SYS/class/net/$NETIF" ]; then
		problem "no network interface $NETIF"
		return
	fi
	now=$(cat "$SYS/class/net/$NETIF/address")
	# 1: random (net_addr_assign_type)
	if [ "$(cat "$SYS/class/net/$NETIF/addr_assign_type")" != 1 ]; then
		say "MAC address $now (from the board's EEPROM)"
		return
	fi
	saved=$(cat "$STATE/mac" 2>/dev/null)
	case $saved in
	[0-9a-f][26ae]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f])
		mac=$saved
		say "MAC address $mac (the EEPROM has none; kept from an earlier boot)"
		return
		;;
	esac
	# locally administered, unicast: the first byte's two low bits 10
	set -- $(od -An -tx1 -N6 /dev/urandom)
	first=$(printf '%02x' $(((0x$1 & 0xfc) | 0x02)))
	mac="$first:$2:$3:$4:$5:$6"
	if mkdir -p "$STATE" && echo "$mac" > "$STATE/mac.new" && mv -f "$STATE/mac.new" "$STATE/mac"; then
		say "MAC address $mac (the EEPROM has none; made now and kept)"
	else
		problem "MAC address $mac for this boot only: /config can't be written"
	fi
}

# -------------------------------------------------------- the network

network_setting() {
	fallback=0
	case $network in
	'' | dhcp) network=dhcp ;;
	static)
		ok=1
		if ! ipv4_prefix "$address"; then
			problem "network = static needs address = <a.b.c.d>/<prefix>, e.g. 192.168.1.50/24 (got \"$address\")"
			ok=0
		fi
		if [ -n "$gateway" ] && ! ipv4 "$gateway"; then
			problem "gateway \"$gateway\" is not an IPv4 address"
			ok=0
		fi
		servers=""
		for s in $(printf '%s' "$dns" | tr ',;' '  '); do
			if ipv4 "$s"; then
				servers="$servers $s"
			else
				problem "dns \"$s\" is not an IPv4 address"
				ok=0
			fi
		done
		if [ $ok = 0 ]; then
			say "network: DHCP instead of the static settings above"
			network=dhcp
			fallback=1
		fi
		;;
	*)
		problem "network = \"$network\": dhcp or static; using DHCP"
		network=dhcp
		fallback=1
		;;
	esac

	mkdir -p "$NETDIR"
	{
		echo "# web888-setup, from web888.txt"
		echo "[Match]"
		echo "Name=$NETIF"
		if [ -n "$mac" ]; then
			echo
			echo "[Link]"
			echo "MACAddress=$mac"
		fi
		echo
		echo "[Network]"
		if [ $network = dhcp ]; then
			echo "DHCP=ipv4"
			# with no DHCP server, still reachable straight from a laptop
			echo "LinkLocalAddressing=yes"
		else
			echo "Address=$address"
			[ -n "$gateway" ] && echo "Gateway=$gateway"
			for s in $servers; do
				echo "DNS=$s"
			done
			echo "LinkLocalAddressing=ipv6"
		fi
		echo "IPv6AcceptRA=yes"
		if [ $network = dhcp ]; then
			echo
			echo "[DHCPv4]"
			# the same lease at every boot (the machine ID, which the
			# default identifier comes from, is new at every boot)
			echo "ClientIdentifier=mac"
		fi
	} > "$NETDIR/10-web888.network.new"
	mv -f "$NETDIR/10-web888.network.new" "$NETDIR/10-web888.network"
	if [ $fallback = 1 ]; then
		:
	elif [ $network = dhcp ]; then
		say "network: DHCP"
	else
		say "network: static $address${gateway:+, gateway $gateway}${servers:+, DNS$servers}"
	fi
}

hostname_setting() {
	h=$(printf '%s' "$hostname" | tr 'A-Z' 'a-z')
	if [ -z "$h" ]; then
		h=web888
	elif ! valid_hostname "$h"; then
		problem "hostname \"$hostname\": letters, digits and - only, up to 63; using web888"
		h=web888
	fi
	if [ -z "${WEB888_BOOT:-}" ]; then
		echo "$h" > /proc/sys/kernel/hostname
	fi
	say "hostname: $h (http://$h.local:8073)"
}

# ------------------------------------------------------ the password

has_admin_password() {
	grep -q '^[[:space:]]*admin_hash[[:space:]]*=' "$TOML" 2>/dev/null
}
set_admin_password() {
	printf '%s\n' "$1" | "$WEB888D" passwd --config "$TOML" > /dev/null
}
# NAME with each letter as [nN], so sed takes it in any case
# (as read_settings does)
any_case() {
	s=$1
	out=""
	while [ -n "$s" ]; do
		c=${s%"${s#?}"}
		s=${s#?}
		case $c in
		_) out="${out}_" ;;
		*) out="$out[$c$(printf '%s' "$c" | tr 'a-z' 'A-Z')]" ;;
		esac
	done
	printf '%s' "$out"
}
# web888.txt with the value of setting NAME replaced by "(set)" (the name
# in any case), line ends as they were
mark_taken() {
	end=""
	grep -q "$CR\$" "$TXT" && end=$CR
	pat=$(any_case "$1")
	sed "s/^\\([[:space:]]*$pat[[:space:]]*=\\).*\$/\\1 (set)$end/" "$TXT" | put_file "$TXT"
}
mark_password_taken() { mark_taken admin_password; }

password_setting() {
	if [ ! -d "$CONFIG" ] || ! touch "$CONFIG/.web888-setup" 2>/dev/null; then
		problem "the configuration partition isn't there: no admin password"
		return
	fi
	rm -f "$CONFIG/.web888-setup"
	if [ $have_password = 1 ] && [ "$admin_password" != "(set)" ] && [ -n "$admin_password" ]; then
		if [ ${#admin_password} -lt 8 ]; then
			problem "admin_password: at least 8 characters; not changed"
		elif set_admin_password "$admin_password"; then
			if mark_password_taken; then
				say "admin password: set from web888.txt (the line now reads \"(set)\")"
			else
				say "admin password: set from web888.txt"
			fi
			[ -e "$PWTXT" ] && boot_writable && rm -f "$PWTXT"
			return
		else
			problem "admin_password: web888d couldn't set it"
		fi
	fi
	if has_admin_password; then
		say "admin password: as before"
		return
	fi
	# none yet: make one, so the admin pages are never open
	pw=$(od -An -tx1 -N8 /dev/urandom | tr -d ' \n')
	if ! set_admin_password "$pw"; then
		problem "web888d couldn't set an admin password"
		return
	fi
	{
		echo "Admin password for the web admin pages of http://$h.local:8073:"
		echo
		echo "    $pw"
		echo
		echo "Made by the unit because web888.txt had none. To choose your own,"
		echo "set admin_password in web888.txt; this file then goes away."
	} | sed "s/\$/$CR/" | put_file "$PWTXT"
	say "admin password: made by the unit, in web888-password.txt"
}

# ------------------------------------------------------------------ SSH

ssh_setting() {
	rm -rf "$SSHDIR"
	if [ -z "$ssh_key" ]; then
		say "SSH: off (no ssh_key)"
		return
	fi
	case $ssh_key in
	ssh-* | ecdsa-* | sk-*) ;;
	*)
		problem "ssh_key: not a public key line (ssh-ed25519 AAAA... or similar); SSH stays off"
		return
		;;
	esac
	mkdir -p "$SSHDIR"
	chmod 700 "$SSHDIR"
	printf '%s\n' "$ssh_key" > "$SSHDIR/authorized_keys"
	chmod 600 "$SSHDIR/authorized_keys"
	say "SSH: on for root with the key from web888.txt"
}

# ------------------------------------------------------------ bitstream

# standard: web888d's own choice (its configuration, by default the HF
# bitstream); channelizer: the channelizer bitstream on the command line,
# which web888d then runs in bins mode (over its configuration)
bitstream_setting() {
	mkdir -p "$(dirname "$WEB888D_ENV")"
	extra=""
	case $bitstream in
	'' | standard) say "bitstream: standard" ;;
	channelizer)
		if [ -e "$BITDIR/websdr_pfb.bit" ]; then
			extra="--bitstream $BITDIR/websdr_pfb.bit"
			say "bitstream: channelizer (experimental)"
		else
			problem "bitstream = channelizer: not in this image; the standard one"
		fi
		;;
	*) problem "bitstream = \"$bitstream\": standard or channelizer; the standard one" ;;
	esac
	echo "WEB888D_EXTRA=\"$extra\"" > "$WEB888D_ENV"
}

# -------------------------------------------------------------- tunnels

# Tunnels to the Internet without opening a port on the router: frp,
# rathole and chisel to the owner's VPS, cloudflared to Cloudflare. Each
# client's service starts only when its configuration is in /run. Their
# secrets are kept on the configuration partition once taken, and their
# lines in web888.txt read "(set)".

FRP_TOML=$RUN/web888/frpc.toml
CLOUDFLARED_ENV=$RUN/web888/cloudflared.env
RATHOLE_TOML=$RUN/web888/rathole.toml
CHISEL_ENV=$RUN/web888/chisel.env
WEB_PORT=8073

port_ok() {
	case $1 in
	'' | *[!0-9]*) return 1 ;;
	esac
	[ ${#1} -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# host_port SETTING VALUE DEFAULT_PORT: tunnel_host and tunnel_port, or a
# problem
host_port() {
	tunnel_host=$2
	tunnel_port=$3
	case $2 in
	*:*)
		tunnel_host=${2%:*}
		tunnel_port=${2##*:}
		;;
	esac
	case $tunnel_host in
	'' | -* | *[!A-Za-z0-9.-]*)
		problem "$1 \"$2\": host[:port], e.g. vps.example.org:$3; no tunnel"
		return 1
		;;
	esac
	if ! port_ok "$tunnel_port"; then
		problem "$1 \"$2\": the port must be 1-65535; no tunnel"
		return 1
	fi
}

# name_ok SETTING VALUE: a name for the tunnel at the server
name_ok() {
	case $2 in
	'' | *[!A-Za-z0-9_-]*)
		problem "$1 \"$2\": letters, digits, - and _ only; no tunnel"
		return 1
		;;
	esac
}

# keep_secret SETTING VALUE [CHECK]: a new value from web888.txt (that
# the function CHECK takes) goes to the configuration partition and its
# line then reads "(set)"; the kept value comes back in $secret (empty:
# none)
keep_secret() {
	file=$STATE/$(printf '%s' "$1" | tr _ -)
	if [ -n "$2" ] && [ "$2" != "(set)" ]; then
		if printf '%s' "$2" | grep -q '["\\$`[:cntrl:][:space:]]'; then
			problem "$1: no quotes, backslashes, \$, \` or spaces; not changed"
		elif [ $# -gt 2 ] && ! "$3" "$2"; then
			problem "$1: $check_says; not changed"
		elif mkdir -p "$STATE" && (umask 077; printf '%s\n' "$2" > "$file.new") &&
			mv -f "$file.new" "$file"; then
			if mark_taken "$1"; then
				say "$1: taken from web888.txt (the line now reads \"(set)\")"
			else
				say "$1: taken from web888.txt"
			fi
		else
			problem "$1: the configuration partition can't be written; not kept"
		fi
	fi
	secret=$(cat "$file" 2>/dev/null)
}

# private FILE: stdin to FILE, readable by root only
private() {
	mkdir -p "$(dirname "$1")"
	(umask 077; cat > "$1.new") && mv -f "$1.new" "$1"
}

# Connections through a tunnel client come from 127.0.0.1; web888d takes
# the visitor's address from X-Forwarded-For (set by the VPS's web server
# or by Cloudflare) only from trusted proxies. Without this every visitor
# would count as one address in the per-address limits.
trust_loopback() {
	if grep '^[[:space:]]*trusted_proxies[[:space:]]*=' "$TOML" 2>/dev/null | grep -q '127\.0\.0\.1'; then
		return
	fi
	if grep -q '^[[:space:]]*trusted_proxies[[:space:]]*=' "$TOML" 2>/dev/null; then
		# web888d writes "trusted_proxies = []" itself; a list on one
		# line gets 127.0.0.1 too
		sed -e 's/^\([[:space:]]*trusted_proxies[[:space:]]*=[[:space:]]*\[\)[[:space:]]*\]/\1"127.0.0.1"]/' \
			-e t \
			-e 's/^\([[:space:]]*trusted_proxies[[:space:]]*=[[:space:]]*\[[^]]*[^][:space:]]\)[[:space:]]*\]/\1, "127.0.0.1"]/' \
			"$TOML" > "$TOML.new"
		if grep '^[[:space:]]*trusted_proxies' "$TOML.new" | grep -q '127\.0\.0\.1' && mv -f "$TOML.new" "$TOML"; then
			say "tunnel: 127.0.0.1 added to trusted_proxies in web888d's configuration"
		else
			rm -f "$TOML.new"
			problem "tunnel: trusted_proxies in $TOML is not a one-line list: add \"127.0.0.1\" yourself, or visitors count as one address in the limits"
		fi
		return
	fi
	[ -f "$TOML" ] || : > "$TOML"
	if grep -q '^\[web\][[:space:]]*$' "$TOML"; then
		sed 's/^\[web\][[:space:]]*$/&\
trusted_proxies = ["127.0.0.1"]/' "$TOML" > "$TOML.new"
	else
		{
			cat "$TOML"
			printf '\n[web]\ntrusted_proxies = ["127.0.0.1"]\n'
		} > "$TOML.new"
	fi
	if mv -f "$TOML.new" "$TOML"; then
		say "tunnel: trusted_proxies = [\"127.0.0.1\"] added to web888d's configuration"
	else
		problem "tunnel: couldn't add trusted_proxies to $TOML: visitors count as one address in the limits"
	fi
}

# frp: frpc takes web888d's port to a port on the VPS (frps), where a web
# server faces the public. TLS to frps is frp's default.
frp_setting() {
	if [ -z "$frp_server" ]; then
		say "frp: off (no frp_server)"
		return
	fi
	host_port frp_server "$frp_server" 7000 || return
	if ! port_ok "$frp_remote_port"; then
		problem "frp_remote_port \"$frp_remote_port\": 1-65535, the port on the VPS; no tunnel"
		return
	fi
	name=${frp_name:-web888}
	name_ok frp_name "$name" || return
	keep_secret frp_token "$frp_token"
	if [ -z "$secret" ]; then
		problem "frp_token: none (the VPS's frps token); no tunnel"
		return
	fi
	private "$FRP_TOML" <<TOMLEND || { problem "frp: couldn't write frpc's configuration; no tunnel"; return; }
# web888-setup, from web888.txt
serverAddr = "$tunnel_host"
serverPort = $tunnel_port
loginFailExit = false
auth.method = "token"
auth.token = "$secret"
log.to = "console"

[[proxies]]
name = "$name"
type = "tcp"
localIP = "127.0.0.1"
localPort = $WEB_PORT
remotePort = $frp_remote_port
TOMLEND
	say "frp: web888d to $tunnel_host:$tunnel_port as \"$name\", port $frp_remote_port on the VPS"
	trust_loopback
}

cloudflared_token_ok() {
	check_says="not a tunnel token (letters, digits, + / = _ -)"
	case $1 in
	*[!A-Za-z0-9+/=_-]*) return 1 ;;
	esac
}

# Cloudflare Tunnel: the tunnel, its public hostname and its service
# (http://localhost:8073) are made at Cloudflare; the unit only needs the
# tunnel's token.
cloudflared_setting() {
	if [ -z "$cloudflared_token" ]; then
		say "cloudflared: off (no cloudflared_token)"
		return
	fi
	keep_secret cloudflared_token "$cloudflared_token" cloudflared_token_ok
	if [ -z "$secret" ]; then
		problem "cloudflared_token: none kept yet (the token from Cloudflare); no tunnel"
		return
	fi
	printf 'TUNNEL_TOKEN=%s\n' "$secret" | private "$CLOUDFLARED_ENV" || {
		problem "cloudflared: couldn't write its token to /run; no tunnel"
		return
	}
	say "cloudflared: web888d through Cloudflare (the hostname is set there)"
	trust_loopback
}

# rathole: like frp, the VPS (rathole --server) opens the public port for
# the service of this name. Encrypted with Noise: the unit checks the
# server by its public key.
rathole_setting() {
	if [ -z "$rathole_server" ]; then
		say "rathole: off (no rathole_server)"
		return
	fi
	host_port rathole_server "$rathole_server" 2333 || return
	name=${rathole_name:-web888}
	name_ok rathole_name "$name" || return
	case $rathole_server_key in
	'' | *[!A-Za-z0-9+/=]*)
		problem "rathole_server_key: the server's Noise public key (from rathole --genkey); no tunnel"
		return
		;;
	esac
	keep_secret rathole_token "$rathole_token"
	if [ -z "$secret" ]; then
		problem "rathole_token: none (the service's token on the VPS); no tunnel"
		return
	fi
	private "$RATHOLE_TOML" <<TOMLEND || { problem "rathole: couldn't write its configuration; no tunnel"; return; }
# web888-setup, from web888.txt
[client]
remote_addr = "$tunnel_host:$tunnel_port"

[client.transport]
type = "noise"

[client.transport.noise]
remote_public_key = "$rathole_server_key"

[client.services.$name]
token = "$secret"
local_addr = "127.0.0.1:$WEB_PORT"
TOMLEND
	say "rathole: web888d to $tunnel_host:$tunnel_port as \"$name\""
	trust_loopback
}

chisel_auth_ok() {
	check_says="user:password, as at the server"
	case $1 in
	?*:?*) ;;
	*) return 1 ;;
	esac
}

# chisel: SSH over a WebSocket, so the VPS's web server can carry it on
# its HTTPS port; the unit's port is opened on the VPS's loopback only.
chisel_setting() {
	if [ -z "$chisel_server" ]; then
		say "chisel: off (no chisel_server)"
		return
	fi
	case $chisel_server in
	*[!A-Za-z0-9.:/_-]* | -*)
		problem "chisel_server \"$chisel_server\": a URL (https://vps.example.org) or host:port; no tunnel"
		return
		;;
	esac
	if ! port_ok "$chisel_remote_port"; then
		problem "chisel_remote_port \"$chisel_remote_port\": 1-65535, the port on the VPS; no tunnel"
		return
	fi
	fingerprint=""
	case $chisel_fingerprint in
	'') ;;
	*[!A-Za-z0-9+/=]*)
		problem "chisel_fingerprint: the server's fingerprint (44 characters, from its log); no tunnel"
		return
		;;
	*) fingerprint="--fingerprint $chisel_fingerprint " ;;
	esac
	keep_secret chisel_auth "$chisel_auth" chisel_auth_ok
	if [ -z "$secret" ]; then
		problem "chisel_auth: none (user:password, as at the server); no tunnel"
		return
	fi
	remote="R:127.0.0.1:$chisel_remote_port:127.0.0.1:$WEB_PORT"
	printf 'AUTH=%s\nCHISEL_ARGS=%s%s %s\n' "$secret" "$fingerprint" "$chisel_server" "$remote" |
		private "$CHISEL_ENV" || {
		problem "chisel: couldn't write its settings to /run; no tunnel"
		return
	}
	say "chisel: web888d to $chisel_server, port $chisel_remote_port on the VPS${fingerprint:+ (fingerprint checked)}"
	[ -z "$fingerprint" ] && say "chisel: no chisel_fingerprint: the server's key is not checked"
	trust_loopback
}

tunnel_settings() {
	rm -f "$FRP_TOML" "$CLOUDFLARED_ENV" "$RATHOLE_TOML" "$CHISEL_ENV"
	frp_setting
	cloudflared_setting
	rathole_setting
	chisel_setting
}

# ----------------------------------------------------------------- main

board_info() {
	slot=$(sed -n 's/.*rauc\.slot=\([A-Za-z]*\).*/\1/p' /proc/cmdline 2>/dev/null)
	. /etc/os-release 2>/dev/null
	say "web888-ng ${VERSION_ID:-?}${BUILD_ID:+ ($BUILD_ID)}, root slot ${slot:-?}"
}

board_info
if [ -e "$TXT" ]; then
	read_settings
else
	say "no web888.txt on the card: the defaults"
fi
mac_setting
network_setting
hostname_setting
password_setting
ssh_setting
bitstream_setting
tunnel_settings
[ $problems = 0 ] && say "no problems"

# the log, rewritten only when it says something new
if [ "$(sed "s/$CR\$//" "$LOG" 2>/dev/null)" != "$(printf '%s' "$report")" ]; then
	printf '%s' "$report" | sed "s/\$/$CR/" | put_file "$LOG"
fi
boot_done
exit 0
