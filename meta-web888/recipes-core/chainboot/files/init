#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Initramfs init for a chain-loaded boot from the stock firmware. The root
# is /rootfs.squashfs, appended to this initramfs by
# scripts/chainboot-pack.sh, mounted read-only under a tmpfs overlay; the
# unit's own files (network, ssh keys, web888d configuration) come from
# /overlay and are copied on top. Nothing on the SD card is written.
# Any failure stops here: on the unit, the armed watchdog then resets it
# into the stock firmware.

mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys

fail() {
	echo "chainboot-init: $*" > /dev/kmsg
	exec sh
}

mkdir -p /mnt/lower /mnt/rw /newroot
mount -t squashfs -o loop,ro /rootfs.squashfs /mnt/lower || fail "no root"
mount -t tmpfs -o mode=0755,size=64m tmpfs /mnt/rw || fail "no tmpfs"
mkdir -p /mnt/rw/upper /mnt/rw/work
if [ -d /overlay ]; then
	cp -a /overlay/. /mnt/rw/upper/ || fail "overlay files"
fi
mount -t overlay -o lowerdir=/mnt/lower,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work \
	overlay /newroot || fail "no overlay"

echo "chainboot-init: root on a RAM overlay" > /dev/kmsg
umount /proc /sys
mount --move /dev /newroot/dev
exec switch_root /newroot /sbin/init
