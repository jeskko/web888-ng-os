/*
 * Web-888 (web888-ng): U-Boot's default environment.
 *
 * A/B boot with RAUC's U-Boot boot chooser: BOOT_ORDER lists the root
 * slots to try (A = partition 2, B = 3) and BOOT_<slot>_LEFT the tries
 * each has left. Each boot takes one try from the first slot with tries
 * left; Linux gives them back (web888-boot-ok, as RAUC's "mark-good")
 * once web888d runs. A slot that keeps failing runs out of tries and the next one
 * boots. With none left, both get their tries back and the unit resets
 * (the watchdog, started here, catches a boot that hangs).
 *
 * The environment lives on the SD card in two copies (1 MiB and 1.25
 * MiB, before the first partition; /etc/fw_env.config in Linux). The
 * EEPROM's U-Boot environment holds the board data and is never written.
 *
 * The saved environment would keep the scripts of the U-Boot that first
 * saved it; bootcmd ("env default -f web888_boot; run web888_boot")
 * takes web888_boot from this U-Boot instead, and web888_boot does the
 * same for the rest. Only the boot chooser's variables carry over.
 */

bootdelay=1
kernel_addr_r=0x02000000
fdt_addr_r=0x01f00000
console=ttyPS0,115200
web888_bootargs=console=ttyPS0,115200 earlycon rootwait ro panic=10 net.ifnames=0

web888_defaults=web888_clock web888_bootargs kernel_addr_r fdt_addr_r bootdelay

/*
 * The ADC clock, as the stock first-stage loader sets it: the internal
 * reference (MIO 49 high) and the HF path (MIO 10 low), raw levels as
 * web888d drives them later; then the Si5351 (I2C 0x60) for 122.88 MHz
 * on CLK0 from its 24.576 MHz crystal: all outputs off, crystal load
 * 10 pF, PLLA = 30 (737.28 MHz), MultiSynth0 = 6 (integer), CLK0 on at
 * 8 mA. Registers and values in hex (AN619). The bitstream needs this
 * clock before it loads (web888-ng-hw docs/server-fpga-interface.md).
 */
web888_clock=
	gpio set 49;
	gpio clear 10;
	i2c dev 0;
	if i2c mw 60 03 ff; then
		i2c mw 60 10 80 8;
		i2c mw 60 b7 c0;
		i2c mw 60 1a a0; i2c mw 60 1b 00; i2c mw 60 1c 00; i2c mw 60 1d 0d;
		i2c mw 60 1e 00; i2c mw 60 1f f0; i2c mw 60 20 00; i2c mw 60 21 00;
		i2c mw 60 b1 a0;
		i2c mw 60 10 4f;
		i2c mw 60 2a 00; i2c mw 60 2b 01; i2c mw 60 2c 00; i2c mw 60 2d 01;
		i2c mw 60 2e 00; i2c mw 60 2f 00; i2c mw 60 30 00; i2c mw 60 31 00;
		i2c mw 60 a5 00;
		i2c mw 60 03 fe;
		echo "web888: ADC clock 122.88 MHz";
	else
		echo "web888: no Si5351 at I2C 0x60: no ADC clock";
	fi

web888_boot=
	env default -f ${web888_defaults};
	run web888_clock;
	test -n "${BOOT_ORDER}" || setenv BOOT_ORDER "A B";
	test -n "${BOOT_A_LEFT}" || setenv BOOT_A_LEFT 3;
	test -n "${BOOT_B_LEFT}" || setenv BOOT_B_LEFT 3;
	setenv web888_part;
	for BOOT_SLOT in ${BOOT_ORDER}; do
		if test -n "${web888_part}"; then
			true;
		elif test "${BOOT_SLOT}" = "A" && test ${BOOT_A_LEFT} -gt 0; then
			setexpr BOOT_A_LEFT ${BOOT_A_LEFT} - 1;
			setenv web888_part 2;
			setenv web888_slot A;
		elif test "${BOOT_SLOT}" = "B" && test ${BOOT_B_LEFT} -gt 0; then
			setexpr BOOT_B_LEFT ${BOOT_B_LEFT} - 1;
			setenv web888_part 3;
			setenv web888_slot B;
		fi;
	done;
	if test -z "${web888_part}"; then
		echo "web888: no slot has tries left: both get 3 again, resetting";
		setenv BOOT_A_LEFT 3;
		setenv BOOT_B_LEFT 3;
		saveenv;
		reset;
	fi;
	saveenv;
	echo "web888: slot ${web888_slot} (partition ${web888_part}), tries left A ${BOOT_A_LEFT} B ${BOOT_B_LEFT}";
	setenv bootargs "${web888_bootargs} root=/dev/mmcblk0p${web888_part} rauc.slot=${web888_slot}";
	if load mmc 0:${web888_part} ${fdt_addr_r} /boot/zynq-web888.dtb; then
		if load mmc 0:${web888_part} ${kernel_addr_r} /boot/zImage; then
			bootz ${kernel_addr_r} - ${fdt_addr_r};
		elif load mmc 0:${web888_part} ${kernel_addr_r} /boot/uImage; then
			bootm ${kernel_addr_r} - ${fdt_addr_r};
		fi;
	fi;
	echo "web888: slot ${web888_slot} did not boot; resetting";
	reset
