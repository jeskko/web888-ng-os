# SPDX-License-Identifier: GPL-3.0-or-later
# Web-888 SD card, A/B (U-Boot's boot chooser, meta-web888/recipes-bsp/
# u-boot/files/web888.env):
#
#   0 - 4 MiB   MBR; U-Boot's environment at 1 MiB and 1.25 MiB (raw)
#   p1  64 MiB  FAT "WEB888": BOOT.BIN (SPL), u-boot.img, web888.txt (the
#               owner's settings, web888-setup)
#   p2 512 MiB  ext4 root slot A, with the kernel and DT in /boot
#   p3 512 MiB  ext4 root slot B: the same image at first
#   p4  32 MiB  ext4 "config": empty; web888d's configuration and state,
#               written only when they change
#
# fstab entries come from base-files (by label, with their options: /boot
# read-only), not from wic: WIC_CREATE_EXTRA_ARGS in the machine config
part /boot   --source bootimg_partition --fstype=vfat --label WEB888 --active --align 4096 --fixed-size 64M
part /       --source rootfs --fstype=ext4 --label rootA --align 4096 --fixed-size 512M
part         --source rootfs --fstype=ext4 --label rootB --align 4096 --fixed-size 512M
part /config                 --fstype=ext4 --label config --align 4096 --fixed-size 32M
