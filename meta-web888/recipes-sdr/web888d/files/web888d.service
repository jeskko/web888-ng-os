[Unit]
Description=web888-ng SDR server
# /dev/zynqsdr appears once the driver has autoloaded (udev rule in
# web888-sdr); without it, start fails after the device timeout.
Requires=dev-zynqsdr.device
After=dev-zynqsdr.device local-fs.target

[Service]
EnvironmentFile=/etc/default/web888d
ExecStart=/usr/bin/web888d $WEB888D_ARGS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
